package compilador;

import java_cup.runtime.*;
import java.util.ArrayList;
import java.util.List;

/*
 * OBJETIVO: configurar y se define el analizador sintactico usando cup
 * esto es lo que se va a insertar en la clase del parser qe se va a generar
 * para guardar los errores que se vayan encontrando y que el compilador pueda revisar el resto del codigo
 *
 * ENTRADAS: se tiene el simbolo que no es uno esperado con su linea para enseñar el error
 * SALIDAS: va agregarndo los errores en una lista para que se muestren al final del analisis
 *
 * PROYECTO 2: las producciones tienen acciones semanticas {: ... :} que registran las
 * declaraciones en la tabla de simbolos semantica (TablaSemantica) y validan tipos.
 * Los errores semanticos quedan en parser.tabla.getErrores() y Main los reporta.
 */
parser code {:
    // para guardar los errores de sintaxis sin que se frene el analisis
    public java.util.List<String> erroresSintacticos = new java.util.ArrayList<>();

    // tabla de simbolos semantica: la usan las acciones semanticas y Main lee sus resultados
    public TablaSemantica tabla = new TablaSemantica();

    // metodo para el modo de panico, para los errores de sintaxis se vayan agregando a la lista que se va a mostrar al final
    // y se va siguiendo con el analisis sin freno para recopilar todos los errores
    public void syntax_error(Symbol cur_token) {
        String m = "Error sintactico en linea " + cur_token.left + ", columna " + cur_token.right + ". Token no esperado: " + cur_token.value;
        erroresSintacticos.add(m);
        System.err.println(m);
    }

    // solo para cuando el panico no es suficente y no se puede seguir leyendo el resto del codigo
    // tecnicamente lo que hace es encontrar el proximo punto seguro para poder seguir revisando
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        erroresSintacticos.add("Error fatal: no se pudo recuperar de los errores sintacticos.");
        report_fatal_error("Error fatal: No se pudo recuperar de los errores sintacticos.", null);
    }
:};

/*
 * action code: codigo disponible dentro de las acciones semanticas {: ... :}
 * "parser" es el objeto parser que se esta ejecutando (de ahi se toma la tabla)
 */
action code {:
    // atajo para llegar a la tabla de simbolos semantica desde las acciones
    TablaSemantica tabla() { return parser.tabla; }
:};

/*
 * =====================
 * declaracion de tokens
 * =====================
 * Cada token trae como valor su lexema (String). Ademas, con "token:nombre" en una
 * produccion se obtienen nombreleft (linea) y nombreright (columna), que pone el Lexer.
 */
terminal String VAL, INT, FLOAT, BOOLEAN, CHAR, STRING, VOID, PRINCIPAL, TRUE, FALSE;
terminal String IF, ELIF, ELSE, WHILE, FOR, RETURN, BREAK, READ, WRITE;
terminal String IDENTIFICADOR, LITERAL_ENTERO, LITERAL_FLOTANTE, LITERAL_CARACTER, LITERAL_CADENA;
terminal String SUMA, RESTA, MULT, DIV, DIV_ENT, MOD, POT, INC, DEC;
terminal String MENOR, MENOR_IG, MAYOR, MAYOR_IG, IGUAL, DIFERENTE;
terminal String AND, OR, NOT;
terminal String ASIGNACION, FIN_SENT, COMA;
terminal String BLOQUE_ABRE, BLOQUE_CIERRA, INDICE_ABRE, INDICE_CIERRA, PAREN_ABRE, PAREN_CIERRA;


/*
 * ===================
 * reglas de gramatica
 * ===================
 * El tipo despues de "non terminal" es el valor (RESULT) que devuelve la produccion:
 *   Tipo            -> un tipo de dato (int, float, ...)
 *   Expr            -> una expresion con su tipo (ver Expr.java)
 *   String          -> el lexema de un literal
 *   InfoDeclaracion -> lo que sigue al nombre en un "val" (escalar o arreglo)
 * Los que no tienen tipo no devuelven nada.
 */
non terminal programa, globales, declaracion, principal, bloque, sentencias, sentencia;
non terminal funciones, funcion, return_stmt, funcion_io;
non terminal estructura_control, si_condicional, lista_elif, bloque_elif, bloque_else, condicion;
non terminal ciclo_while, ciclo_for, for_init, for_update, break_stmt;
non terminal asignacion_var, sentencia_expr;

// marcadores para abrir ambitos (ver seccion de bloques y ciclos)
non terminal abre_bloque, inicio_while, inicio_for;

non terminal Tipo tipo_numerico, tipo_otro, tipo_dato, tipo_retorno;
non terminal Simbolo parametro;
non terminal ArrayList<Simbolo> parametros;
non terminal InfoDeclaracion resto_escalar, resto_numerico;
non terminal ArrayList<Expr> lista_valores;
non terminal Expr acceso_arreglo, variable, valor, llamada_funcion, parametro_write;
non terminal Expr expr_general, expr_grupo, expr_booleana;
non terminal Expr expr_relacional, expr_comparable, grupo, expr_logica;
non terminal Expr expr_arit, termino, residuo, factor, base;
non terminal Expr numero_con_signo;
non terminal String op_rel, entero, flotante, caracter, cadena, booleano;

start with programa;

/* ==================================
 * estructura y globales del programa
 * ==================================*/
// que exista un principal se valida en Main cuando termina el parse (no aqui:
// con errores sintacticos, CUP puede reducir programa antes de tiempo y repetir la accion)
programa ::=
    globales funciones
    | funciones
    ;

globales ::=
    globales declaracion
    | declaracion
    // aqui se sincroniza el panico por si hay error que no se frene el analisis
    | globales error FIN_SENT
    // error en la primera declaracion global (todavia no hay "globales" antes)
    | error FIN_SENT
    ;

// la accion del medio se ejecuta al leer el encabezado, ANTES del cuerpo:
// asi las sentencias del cuerpo ya estan dentro del ambito de principal
principal ::=
    VOID:inicio PRINCIPAL PAREN_ABRE PAREN_CIERRA
        {: tabla().entrarPrincipal(inicioleft, inicioright); :}
    bloque
        {: tabla().salirFuncion(); :}
    ;

/* ==================================
 * bloques: cada ¿: :? es un ambito
 * ==================================
 * abre_bloque existe solo para ejecutar una accion apenas se lee el ¿:
 * (CUP no permite la misma accion al inicio de varias alternativas).
 * Todas las alternativas de bloque cierran el ambito, incluso las de error. */
abre_bloque ::= BLOQUE_ABRE     {: tabla().abrirBloque(); :} ;

bloque ::=
    abre_bloque sentencias BLOQUE_CIERRA            {: tabla().cerrarAmbito(); :}
    | abre_bloque BLOQUE_CIERRA                     {: tabla().cerrarAmbito(); :}
    // panico: el :? cierra ESTE bloque, asi el bloque padre conserva el suyo
    | abre_bloque sentencias error BLOQUE_CIERRA    {: tabla().cerrarAmbito(); :}
    | abre_bloque error BLOQUE_CIERRA               {: tabla().cerrarAmbito(); :}
    ;

sentencias ::=
    sentencias sentencia
    | sentencia
    ;

sentencia ::=
    declaracion
    | asignacion_var
    | sentencia_expr
    | estructura_control
    | funcion_io
    | return_stmt
    | break_stmt
    // sincronisacion de panico para errores en sentencias
    | error FIN_SENT
    | error bloque
    ;

/* ==========================
 * tipos, literales,variables
 * ========================== */
tipo_numerico ::=
    INT         {: RESULT = Tipo.INT; :}
    | FLOAT     {: RESULT = Tipo.FLOAT; :}
    ;
tipo_otro ::=
    BOOLEAN     {: RESULT = Tipo.BOOLEAN; :}
    | CHAR      {: RESULT = Tipo.CHAR; :}
    | STRING    {: RESULT = Tipo.STRING; :}
    ;
tipo_dato ::=
    tipo_numerico:tipo  {: RESULT = tipo; :}
    | tipo_otro:tipo    {: RESULT = tipo; :}
    ;

// los literales devuelven su lexema; la persona B arma el Expr en numero_con_signo y demas
booleano ::= TRUE:lexema {: RESULT = lexema; :} | FALSE:lexema {: RESULT = lexema; :} ;
entero ::= LITERAL_ENTERO:lexema     {: RESULT = lexema; :} ;
flotante ::= LITERAL_FLOTANTE:lexema {: RESULT = lexema; :} ;
caracter ::= LITERAL_CARACTER:lexema {: RESULT = lexema; :} ;
cadena ::= LITERAL_CADENA:lexema     {: RESULT = lexema; :} ;

numero_con_signo ::=
    RESTA entero | entero | RESTA flotante | flotante ;

// la declaracion se registra cuando ya se leyo todo (nombre + resto), por eso
// "val int a Ͱ a »" reporta que 'a' no esta declarada en su propio valor inicial
declaracion ::=
    VAL tipo_numerico:tipo IDENTIFICADOR:nombre resto_numerico:resto
        {: tabla().declararVariable(tipo, nombre, nombreleft, nombreright, resto); :}
    | VAL tipo_otro:tipo IDENTIFICADOR:nombre resto_escalar:resto
        {: tabla().declararVariable(tipo, nombre, nombreleft, nombreright, resto); :}
    ;

resto_escalar ::=
    FIN_SENT:fin
        {: RESULT = InfoDeclaracion.escalar(null, finleft, finright); :}
    | ASIGNACION:asignacion expr_general:valor FIN_SENT
        {: RESULT = InfoDeclaracion.escalar(valor, asignacionleft, asignacionright); :}
    ;

resto_numerico ::=
    resto_escalar:resto
        {: RESULT = resto; :}
    | INDICE_ABRE entero:tamano INDICE_CIERRA FIN_SENT
        {: RESULT = InfoDeclaracion.arreglo(tamano, tamanoleft, tamanoright, null); :}
    | INDICE_ABRE entero:tamano INDICE_CIERRA ASIGNACION BLOQUE_ABRE lista_valores:valores BLOQUE_CIERRA FIN_SENT
        {: RESULT = InfoDeclaracion.arreglo(tamano, tamanoleft, tamanoright, valores); :}
    ;

// lista de expresiones: valores iniciales de un arreglo o argumentos de una llamada
lista_valores ::=
    lista_valores:lista COMA expr_general:valor {: lista.add(valor); RESULT = lista; :}
    | expr_general:valor                        {: RESULT = new ArrayList<Expr>(); RESULT.add(valor); :}
    ;

asignacion_var ::=
    variable ASIGNACION expr_general FIN_SENT
    ;

sentencia_expr ::=
    expr_general FIN_SENT
    ;

acceso_arreglo ::=
    IDENTIFICADOR:nombre INDICE_ABRE expr_arit:indice INDICE_CIERRA
        {: RESULT = tabla().usarArreglo(nombre, nombreleft, nombreright, indice); :}
    ;

variable ::=
    IDENTIFICADOR:nombre    {: RESULT = tabla().usarVariable(nombre, nombreleft, nombreright); :}
    | acceso_arreglo:acceso {: RESULT = acceso; :}
    ;

valor ::=
    variable:usoVariable    {: RESULT = usoVariable; :}
    | llamada_funcion:llamada {: RESULT = llamada; :}
    ;

llamada_funcion ::=
    IDENTIFICADOR:nombre PAREN_ABRE lista_valores:argumentos PAREN_CIERRA
        {: RESULT = tabla().llamarFuncion(nombre, nombreleft, nombreright, argumentos); :}
    | IDENTIFICADOR:nombre PAREN_ABRE PAREN_CIERRA
        {: RESULT = tabla().llamarFuncion(nombre, nombreleft, nombreright, new ArrayList<Expr>()); :}
    ;

/* =============================
 * funciones, entradas y salidas
 * =============================*/
funciones ::= funciones funcion | funcion ;

// igual que en principal: la accion del medio declara la funcion y sus parametros
// antes de leer el cuerpo (por eso una funcion puede llamarse a si misma)
funcion ::=
    tipo_retorno:tipo IDENTIFICADOR:nombre PAREN_ABRE parametros:listaParametros PAREN_CIERRA
        {: tabla().entrarFuncion(tipo, nombre, nombreleft, nombreright, listaParametros); :}
    bloque
        {: tabla().salirFuncion(); :}
    | tipo_retorno:tipo IDENTIFICADOR:nombre PAREN_ABRE PAREN_CIERRA
        {: tabla().entrarFuncion(tipo, nombre, nombreleft, nombreright, new ArrayList<Simbolo>()); :}
    bloque
        {: tabla().salirFuncion(); :}
    // principal puede ir en cualquier posicion entre las funciones;
    // que haya exactamente uno se valida en la fase semantica
    | principal
    // encabezado de funcion invalido: descarta hasta el ¿: y analiza el cuerpo
    | error bloque
        {: tabla().salirFuncion(); :}
    ;

tipo_retorno ::=
    INT         {: RESULT = Tipo.INT; :}
    | FLOAT     {: RESULT = Tipo.FLOAT; :}
    | CHAR      {: RESULT = Tipo.CHAR; :}
    | BOOLEAN   {: RESULT = Tipo.BOOLEAN; :}
    ;

// los parametros se juntan en una lista; se declaran al entrar a la funcion
parametros ::=
    parametros:lista COMA parametro:nuevo   {: lista.add(nuevo); RESULT = lista; :}
    | parametro:nuevo                       {: RESULT = new ArrayList<Simbolo>(); RESULT.add(nuevo); :}
    ;
parametro ::=
    tipo_dato:tipo IDENTIFICADOR:nombre
        {: RESULT = new Simbolo(nombre, tipo, Simbolo.Categoria.PARAMETRO, nombreleft, nombreright); :}
    ;

return_stmt ::=
    RETURN:instruccion FIN_SENT
        {: tabla().verificarReturn(false, null, instruccionleft, instruccionright); :}
    | RETURN:instruccion expr_general:valor FIN_SENT
        {: tabla().verificarReturn(true, valor, instruccionleft, instruccionright); :}
    ;

funcion_io ::=
    READ PAREN_ABRE variable PAREN_CIERRA FIN_SENT
    | WRITE PAREN_ABRE parametro_write PAREN_CIERRA FIN_SENT
    ;

parametro_write ::=
    variable:usoVariable    {: RESULT = usoVariable; :}
    | numero_con_signo | booleano | caracter | cadena ;

/* =========================================================================
 * estructuras de control
 * ========================================================================= */
estructura_control ::= si_condicional | ciclo_while | ciclo_for ;

// condicion de if/elif/while; si tiene error, el panico se queda dentro de los parentesis
condicion ::=
    PAREN_ABRE expr_booleana PAREN_CIERRA
    | PAREN_ABRE error PAREN_CIERRA
    ;

si_condicional ::=
    IF condicion bloque
    | IF condicion bloque bloque_else
    | IF condicion bloque lista_elif
    | IF condicion bloque lista_elif bloque_else
    ;

lista_elif ::= lista_elif bloque_elif | bloque_elif ;
bloque_elif ::= ELIF condicion bloque ;
bloque_else ::= ELSE bloque ;

// inicio_while e inicio_for marcan que se entro a un ciclo (para validar break).
// El for ademas abre un ambito propio para la variable de control.
inicio_while ::= WHILE      {: tabla().entrarCiclo(); :} ;
inicio_for ::= FOR          {: tabla().abrirFor(); tabla().entrarCiclo(); :} ;

ciclo_while ::=
    inicio_while condicion bloque   {: tabla().salirCiclo(); :}
    ;

ciclo_for ::=
    inicio_for PAREN_ABRE for_init FIN_SENT expr_booleana FIN_SENT for_update PAREN_CIERRA bloque
        {: tabla().salirCiclo(); tabla().cerrarAmbito(); :}
    | inicio_for PAREN_ABRE error PAREN_CIERRA bloque
        {: tabla().salirCiclo(); tabla().cerrarAmbito(); :}
    ;

for_init ::=
    VAL tipo_dato:tipo IDENTIFICADOR:nombre ASIGNACION:asignacion expr_general:valor
        {: tabla().declararVariable(tipo, nombre, nombreleft, nombreright,
                                    InfoDeclaracion.escalar(valor, asignacionleft, asignacionright)); :}
    | variable ASIGNACION expr_general
    ;

for_update ::=
    variable ASIGNACION expr_general
    | IDENTIFICADOR INC
    | IDENTIFICADOR DEC
    ;

break_stmt ::=
    BREAK:instruccion FIN_SENT
        {: if (!tabla().dentroDeCiclo())
               tabla().error(instruccionleft, instruccionright, "break solo puede usarse dentro de un while o un for"); :}
    ;

/* =========================================================================
 * generales, relacionales y logicas
 * =========================================================================
 * Las alternativas de un solo hijo solo pasan el Expr hacia arriba (RESULT = expresion).
 * Las que tienen operadores las completa la persona B con el chequeo de tipos. */
expr_general ::=
    expr_grupo:expresion    {: RESULT = expresion; :}
    | cadena | caracter ;
expr_grupo ::=
    expr_arit:expresion         {: RESULT = expresion; :}
    | expr_logica:expresion     {: RESULT = expresion; :}
    | expr_relacional:expresion {: RESULT = expresion; :}
    | booleano ;
expr_booleana ::=
    expr_logica:expresion       {: RESULT = expresion; :}
    | expr_relacional:expresion {: RESULT = expresion; :}
    | booleano
    | valor:expresion           {: RESULT = expresion; :}
    ;

op_rel ::= MENOR | MENOR_IG | MAYOR | MAYOR_IG | IGUAL | DIFERENTE ;

expr_relacional ::=
    INDICE_ABRE expr_comparable INDICE_CIERRA op_rel INDICE_ABRE expr_comparable INDICE_CIERRA
    ;

expr_comparable ::=
    expr_arit:expresion         {: RESULT = expresion; :}
    | booleano | caracter
    | expr_relacional:expresion {: RESULT = expresion; :}
    | expr_logica:expresion     {: RESULT = expresion; :}
    ;

grupo ::= PAREN_ABRE expr_grupo:expresion PAREN_CIERRA     {: RESULT = expresion; :} ;

expr_logica ::=
    grupo AND grupo
    | grupo OR grupo
    | NOT grupo
    ;

/* ==========================
 * aritmeticas y precedencia
 * ==========================*/
expr_arit ::=
    expr_arit SUMA termino
    | expr_arit RESTA termino
    | termino:expresion         {: RESULT = expresion; :}
    ;

termino ::=
    termino MULT residuo
    | termino DIV residuo
    | termino DIV_ENT residuo
    | residuo:expresion         {: RESULT = expresion; :}
    ;

residuo ::=
    residuo MOD factor
    | factor:expresion          {: RESULT = expresion; :}
    ;

factor ::=
    base POT factor
    | base:expresion            {: RESULT = expresion; :}
    ;

base ::=
    grupo:expresion             {: RESULT = expresion; :}
    | numero_con_signo:expresion {: RESULT = expresion; :}
    | IDENTIFICADOR INC
    | IDENTIFICADOR DEC
    | valor:expresion           {: RESULT = expresion; :}
    ;
